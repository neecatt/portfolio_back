generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Experience {
  id          Int     @id @default(autoincrement())
  jobTitle    String
  companyName String
  date        String
  description String[]
  latest      Boolean
  sortOrder   Int     @default(0)
  technologies String[] @default([])
  companyLink String?
}

model Education {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dateStarted DateTime
  dateEnded   DateTime
  school      String
  location    String
  current     Boolean
}

model Projects {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  githubLink  String?
  websiteLink String?
  techStack   TechStack[]
  category    String @default("AI")
  slug        String @unique @default("untitled-project")
  featured    Boolean @default(false)
  published   Boolean @default(true)
  sortOrder   Int @default(0)
  role        String?
  challenge   String?
  solution    String?
  outcomes    String[] @default([])
  metrics     Json?
  thumbnail   String?
  media       ProjectMedia[]
}

model ProjectMedia {
  id        Int      @id @default(autoincrement())
  projectId Int
  key       String
  altText   String   @default("")
  sortOrder Int      @default(0)
  kind      String   @default("image")
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TechStack {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  projects Projects[]
}

model Resume {
  id          Int        @id @default(autoincrement())
  link        String
}

model Profile {
  id             Int      @id @default(1)
  name           String   @default("Nijat Abdullazada")
  headline       String   @default("Software & ML/AI Engineer")
  intro          String   @default("")
  availability   String   @default("")
  skills         String[] @default([])
  socials        Json?
  seoTitle       String?
  seoDescription String?
}
